# =====================================================================
# AI GREETINGS AV STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` for Local / Docker / Azure deployments,
# or add these keys to Repository Secrets in Hugging Face / Kaggle.
# =====================================================================

# --- Required Core Keys ---
APP_PASSCODE=your_access_passcode_here
GEMINI_API_KEY=your_google_gemini_api_key_here
HF_TOKEN=your_huggingface_read_token_here

# --- 3-Tier Voiceover Waterfall Keys ---
# Tier 1: Sarvam AI (Primary for Indian English & 10 Regional Indian Languages)
SARVAM_API_KEY=your_sarvam_api_key_here

# Tier 2: Azure Neural TTS (via edge-tts - Zero API key required, works automatically!)

# Tier 3: ElevenLabs (Primary for Global English / Final Fallback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Optional Cloud Renderer Key (Only if RENDER_ENGINE="CREATOMATE" in config.py) ---
CREATOMATE_API_KEY=

# --- Optional Server & Notebook Overrides ---
PORT=7860
GRADIO_SHARE=false