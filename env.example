# =====================================================================
# AI GREETINGS AV STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` for Local / Docker / Azure deployments,
# or add these keys to Repository Secrets in Hugging Face / Kaggle.
# =====================================================================

# --- 1. Required Core Keys ---
APP_PASSCODE=your_access_passcode_here
GEMINI_API_KEY=your_google_gemini_api_key_here
# Note: Use a Write token if enabling TRACE_REPO_ID dataset syncing below; otherwise Read token is sufficient
HF_TOKEN=your_huggingface_token_here

# --- 2. 4-Tier Voiceover Waterfall Keys ---
# Tier 1 (bulbul:v4-flash) & Tier 2 (bulbul:v3): Sarvam AI for Indian English & 10 Regional Indian Languages
SARVAM_API_KEY=your_sarvam_api_key_here

# Tier 3: Azure Neural TTS (via edge-tts - Zero API key required, works automatically!)

# Tier 4: ElevenLabs (Primary for Universal/Global English, Final Fallback for Indian context)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- 3. Modular Engine & Quota Switchboard (Optional Overrides) ---
# IMAGE_ENGINE options: FLUX | Z_IMAGE
IMAGE_ENGINE=FLUX
# RENDER_ENGINE options: LOCAL | CREATOMATE | OFF
RENDER_ENGINE=LOCAL
MAX_DAILY_GREETINGS=3

# --- 4. Optional Private Telemetry Sync (Hugging Face Dataset) ---
# Leave blank to store execution_logs.json locally only.
# Or set to "your-hf-username/your-private-dataset" (or full HF dataset URL) to sync logs across platforms.
TRACE_REPO_ID=

# --- 5. Optional Cloud Renderer Key (Only if RENDER_ENGINE="CREATOMATE") ---
CREATOMATE_API_KEY=

# --- 6. Optional Server & Notebook Overrides ---
PORT=7860
# Set GRADIO_SHARE=true on Kaggle / Google Colab to generate a public *.gradio.live link
GRADIO_SHARE=false